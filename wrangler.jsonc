{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labithiotis-portfolio",
  "account_id": "7bc5bf0e3b7386107e27d74c22b449c0",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "labithiotis.com/*", "zone_name": "labithiotis.com" },
    { "pattern": "www.labithiotis.com/*", "zone_name": "labithiotis.com" }
  ],
  "env": {
    "preview": {
      "name": "labithiotis-portfolio-preview",
      "workers_dev": true,
      "routes": []
    }
  }
}
