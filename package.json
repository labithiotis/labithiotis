{
  "name": "labithiotis-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "test": "bun test",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "checks": "bun run lint && bun run doctor && bun run typecheck && bun run test",
    "doctor": "react-doctor . --json-compact --no-lint -y",
    "cf-typegen": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "if [ -e .git ]; then lefthook install; fi"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intersection-observer": "11.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.62.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "lefthook": "2.1.17",
    "react-doctor": "0.9.17",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wrangler": "4.146.0"
  },
  "packageManager": "bun@1.4.2"
}
